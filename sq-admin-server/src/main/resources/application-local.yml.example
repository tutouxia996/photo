# 本地密钥配置示例（不要提交真实 Key）
# 使用步骤：
# 1. 复制本文件为同目录下的 application-local.yml
# 2. 填入高德 Web Key、通义 DashScope API Key
# 3. 重启后端

album:
  map:
    type: amap
    webKey: 请填写你的高德Web服务Key
    jsKey:
  aiLandmark:
    enabled: true
    # 通义千问：https://dashscope.console.aliyun.com/apiKey
    apiKey: 请填写通义DashScope-API-Key
    baseUrl: https://dashscope.aliyuncs.com/compatible-mode/v1
    model: qwen-vl-plus
    maxSample: 40
