# 本地密钥配置示例（不要提交真实 Key）
# 使用步骤：
# 1. 复制本文件为同目录下的 application-local.yml
# 2. 填入高德 Web Key、通义 DashScope API Key
# 3. 阿里云盘同步请在后台「相册管理 → 云盘同步」保存（也可在下方填默认回落值）
# 4. 重启后端（开发：-Dspring.profiles.active=mysql-dev,local；部署：mysql-deploy,local）
# 数据库账号见 application-mysql-dev.yml（开发）或 application-mysql-deploy.yml（部署），勿写在本文件
#
# 百度街景（浏览器端 AK）不在本文件：写在前端 sq-ui-vue3/.env.development.local
#   与 .env.production.local 的 VITE_BAIDU_MAP_AK。地图右上角「高德|百度」双引擎，
#   百度含标准/卫星/全景。详见 doc/地图与密钥配置.md

album:
  map:
    type: amap
    webKey: 请填写你的高德Web服务Key
    jsKey:
  aiLandmark:
    enabled: true
    # 通义千问：https://dashscope.console.aliyun.com/apiKey
    apiKey: 请填写通义DashScope-API-Key
    baseUrl: https://dashscope.aliyuncs.com/compatible-mode/v1
    model: qwen-vl-plus
    maxSample: 40
  photoDraw:
    enabled: true
    # 可与 aiLandmark 共用同一 Key；需在百炼控制台开通万相图生图
    apiKey: 请填写通义DashScope-API-Key
  # 阿里云盘个人相册同步（详见 doc/阿里云盘相册同步.md）
  aliyunDrive:
    enabled: true
    # 浏览器登录 https://www.alipan.com → F12 → Application → Local Storage → token → refresh_token
    refreshToken: 请填写阿里云盘refresh_token
    # 个人相册中的相册名称（或改填 remoteAlbumId）
    remoteAlbumName: 平时拍照
    remoteAlbumId:
    localPath: F:/照片视频备份/平时拍照
    # 后台「磁盘扫描」里该目录对应的 path_id（绑定目标相册后填写）
    scanPathId:
    triggerScan: true
    fullScan: false
    # false=相册内全部原文件（格式不限）；true=仅常见图片/视频扩展名
    mediaOnly: false
    downloadConcurrency: 2
    chunkConcurrency: 8
    multipartMinBytes: 2097152
    tokenFile: D:/uploadPath/album/aliyun-drive-token.json
