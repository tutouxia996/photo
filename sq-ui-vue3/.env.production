# 页面标题
VITE_APP_TITLE = 家庭个人电子相册

# 生产环境配置
VITE_APP_ENV = 'production'

# 管理系统/生产环境（与后端同端口合并部署时留空，请求直打当前域名）
VITE_APP_BASE_API = ''

# 分享链接/二维码的公网根地址（勿带末尾 /）。
# 域名已备案，走 HTTPS 标准端口（nginx 443）。
VITE_APP_SHARE_BASE = https://album.pengorbit.top

# 是否在打包时开启压缩，支持 gzip 和 brotli（隧道场景优先 br，体积更小）
VITE_BUILD_COMPRESS = gzip,brotli