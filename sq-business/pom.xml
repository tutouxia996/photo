    </description>

    <!--仓库路径 -->
    <repositories>
        <repository>
            <id>nexus</id>
            <name>Public Repository of sq</name>
            <url>http://10.11.20.32:8081/repository/maven-public/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>

        <repository>
